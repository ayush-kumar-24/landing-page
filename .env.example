# GoXL Ally — beta registration (join.goxlally.ai)
#
# Copy to `.env.local` for local development and set the real values there.
# `.env.local` is git-ignored and must never be committed.
#
# All of these are SERVER-SIDE ONLY. Never prefix any of them with
# NEXT_PUBLIC_ — that would expose them to the browser.

# Connection string for the SEPARATE managed PostgreSQL database used only by
# the beta registration flow. Not the Ally production database.
# Use the provider's POOLED / transaction-mode connection string on Vercel.
# Most managed providers require TLS, e.g. append ?sslmode=require
#
# ⚠️  NEVER put a real password in THIS file — it is committed to git.
#     Real values belong in `.env.local`, which is git-ignored.
DATABASE_URL=

# --- SMTP (Hostinger mailbox for goxlally.ai) ---------------------------------
# Confirmation and internal emails are sent over SMTP using the real mailbox.
# Host and port have working defaults, so usually only USER/PASSWORD are needed.

# Defaults to smtp.hostinger.com
SMTP_HOST=

# 465 = implicit TLS (default). Use 587 if your network blocks 465.
SMTP_PORT=

# The full mailbox address, e.g. info@goxlally.ai
SMTP_USER=

# The mailbox password (the one you set in hPanel → Emails).
# ⚠️  NEVER put the real password in THIS file — it is committed to git.
SMTP_PASSWORD=

# Sender shown to recipients, e.g. "GoXL Ally <info@goxlally.ai>"
# Hostinger rejects any From address that is not the authenticated mailbox,
# so the address here MUST match SMTP_USER exactly. Only the display name
# in front of it is free.
BETA_FROM_EMAIL=

# Optional. Internal address that receives a notification per new signup.
# Leave blank to disable internal notifications.
BETA_NOTIFY_EMAIL=

# ---------------------------------------------------------------------------
# Public (safe to expose) — the one exception to the rule above.
# ---------------------------------------------------------------------------

# Optional. Absolute https origin used for the logo <img> URLs and the CTA link
# in the confirmation email. Email clients cannot resolve root-relative paths,
# so this must be a full origin with no trailing slash.
# Defaults to https://join.goxlally.ai when unset — only set it to point a
# preview/staging deployment at itself.
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# Waitlist approval — all SERVER-SIDE ONLY
# ---------------------------------------------------------------------------
# Approving a registration creates the founder's account in the Ally platform's
# Supabase project and emails them a sign-in link. Outside production every
# variable in this section may be left blank: registrations go to
# .dev/waitlist.json, emails to .dev/outbox.json (browse them at /dev/outbox),
# and the Supabase step is skipped with a warning. In production ALL of them
# are required, and approval fails closed without them.

# Signs the "Approve" links in the internal notification email. 32+ characters.
# Generate one with:  openssl rand -base64 48
APPROVAL_SECRET=

# The Ally PLATFORM's Supabase project — the one the app itself signs in
# against. Supabase → Project Settings → API → Project URL.
SUPABASE_URL=

# ⚠️  The service_role key bypasses row-level security on the platform's
#     production database. Server-side only. Never NEXT_PUBLIC_. Never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Where approved founders sign in. Defaults to https://goxlally.ai in
# production and http://localhost:5173 (the platform's Vite dev server)
# otherwise. Set only to point at a staging platform.
PLATFORM_URL=

# ---------------------------------------------------------------------------
# The Ally platform's waitlist — where approval actually happens
# ---------------------------------------------------------------------------
# Every registration made here is forwarded to the platform's waitlist queue,
# and the team approves it in the Ally admin panel, next to the founder's plan
# and everything else about them. This site keeps its own row either way: it
# holds the attribution, the policy version, and the phone and LinkedIn the
# platform has no columns for.
#
# Server to server, so the platform's CORS allowlist is not involved and no key
# is needed -- that endpoint is deliberately the one unauthenticated write in
# the Ally API, because someone with no account has to be able to ask for one.

# Optional. Defaults to https://api.goxlally.ai/api/v1/waitlist.
# Set it only to point a preview deployment at a staging platform.
ALLY_WAITLIST_URL=

# Exempts this site's forwards from the platform's per-IP rate limit (5 per 5
# minutes). Every forward arrives from a small pool of serverless egress IPs,
# not the visitor's own address, so without this the sixth founder to
# register anywhere on the site within five minutes is silently rate-limited
# on the platform side -- launch-day traffic is exactly when that happens.
#
# Must match the platform's own WAITLIST_FORWARD_SECRET exactly. Blank on
# either side means no exemption -- a slower failure mode under a traffic
# spike, not a broken one; this site's own RATE_LIMIT/RATE_WINDOW_MS above
# still protects the endpoint either way.
ALLY_WAITLIST_FORWARD_SECRET=

# Whether THIS site may still create logins and email founders.
#
# Blank or anything but "true" means it may not: registering never grants
# instantly, the daily batch is a no-op, and the Approve links in the internal
# email refuse. That is the intended state -- two systems creating Supabase
# identities against the same project is how one founder gets two "you're in"
# emails and two different ideas of how many places are left.
#
# Set it to "true" only to take approval back onto this site, e.g. if the Ally
# panel is unavailable on a day the queue has to move. Everything works exactly
# as it did before, with no deploy: the cron and the Approve links come back.
LANDING_PAGE_GRANTS_ACCESS=
